# MeetUp — environment variables
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed.
# In production these same variables are set in the Vercel dashboard
# (Settings -> Environment Variables).
#
# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC — these ARE shipped to the browser. Only put safe values here.
# The NEXT_PUBLIC_ prefix is what tells Next.js to bundle them into client code.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL. Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON key. Dashboard -> Project Settings -> API -> Project API keys -> anon/public
# Safe to expose: it grants nothing on its own — Row Level Security governs it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY — never sent to the browser. Do NOT add a NEXT_PUBLIC_ prefix to
# any of these; that would leak them into the JavaScript bundle users download.
# They are read only by code under lib/server/ and app/api/.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase SERVICE-ROLE key. Dashboard -> Project Settings -> API -> service_role
# ⚠️ This bypasses Row Level Security entirely. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API key — powers all AI extraction. https://console.anthropic.com
# The app is Claude-only; there is no OpenAI key anywhere in this stack.
ANTHROPIC_API_KEY=sk-ant-your-key

# AssemblyAI API key — speech-to-text. https://www.assemblyai.com
ASSEMBLYAI_API_KEY=your-assemblyai-key

# A random secret YOU invent. Sent to AssemblyAI when submitting audio, and
# checked when AssemblyAI calls our webhook back — this is what proves the
# callback is genuine. Any long random string works, e.g.
#     openssl rand -hex 32
ASSEMBLYAI_WEBHOOK_SECRET=generate-a-long-random-string

# OPTIONAL. Leave blank unless you need to pin the webhook to one canonical
# domain. By default the webhook URL is derived from the incoming request's own
# origin, so it is automatically correct on production, previews and custom
# domains with nothing to configure.
SITE_URL=
